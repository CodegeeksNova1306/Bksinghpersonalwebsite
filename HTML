<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>B. K. Singh | Industrial Leadership &amp; Board Portfolio</title>
  <meta name="description" content="Executive portfolio of B. K. Singh — Integrated steel and power leader with 35+ years of experience across manufacturing operations, large-scale capex execution, and industrial transformation.">
  <meta name="author" content="Birendra Kumar Singh">
  <meta name="theme-color" content="#101D2C">

  <!-- Open Graph Metadata -->
  <meta property="og:title" content="B. K. Singh | Industrial Leadership &amp; Board Portfolio">
  <meta property="og:description" content="35+ years of industrial leadership across integrated steel, power generation, and operational excellence.">
  <meta property="og:type" content="website">

  <!-- Typography -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,400;0,9..40,500;0,9..40,700;1,9..40,400&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet">

  <style>
    /* ==========================================================================
       DESIGN SYSTEM & PALETTE
       ========================================================================== */
    :root {
      --bg-midnight: #101D2C;
      --bg-navy-elevated: #162638;
      --bg-navy-card: #1D3147;
      --bg-paper: #F9F8F5;
      --bg-paper-alt: #EFECE6;
      --bg-paper-card: #FFFFFF;

      --text-dark: #121A24;
      --text-muted: #5A6675;
      --text-light: #F4F6F8;
      --text-light-muted: #9BB0C1;

      --accent-gold: #C4A16A;
      --accent-gold-hover: #D5B480;
      --accent-gold-soft: rgba(196, 161, 106, 0.15);

      --accent-green: #2B6E4F;
      --accent-green-soft: rgba(43, 110, 79, 0.12);

      --border-dark: rgba(255, 255, 255, 0.1);
      --border-light: rgba(18, 26, 36, 0.1);

      --font-heading: 'Manrope', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      --font-body: 'DM Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;

      --container-max: 1200px;
      --container-pad: clamp(1.25rem, 4vw, 2.5rem);
      --section-pad-y: clamp(4rem, 8vw, 7rem);
      --radius-sm: 4px;
      --radius-md: 8px;
      --radius-lg: 12px;
      --transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    }

    *, *::before, *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    html {
      scroll-behavior: smooth;
      -webkit-font-smoothing: antialiased;
    }

    @media (prefers-reduced-motion: reduce) {
      html { scroll-behavior: auto; }
      *, *::before, *::after {
        animation-duration: 0.01ms !important;
        transition-duration: 0.01ms !important;
      }
    }

    body {
      font-family: var(--font-body);
      font-size: 1rem;
      line-height: 1.65;
      color: var(--text-dark);
      background-color: var(--bg-paper);
      overflow-x: hidden;
    }

    h1, h2, h3, h4, h5 {
      font-family: var(--font-heading);
      font-weight: 700;
      line-height: 1.25;
      color: var(--text-dark);
      letter-spacing: -0.015em;
    }

    p { margin-bottom: 1.25rem; }
    p:last-child { margin-bottom: 0; }

    a {
      color: inherit;
      text-decoration: none;
      transition: var(--transition);
    }

    img {
      max-width: 100%;
      height: auto;
      display: block;
    }

    button {
      font-family: inherit;
      cursor: pointer;
      border: none;
      background: none;
    }

    .container {
      width: 100%;
      max-width: var(--container-max);
      margin-left: auto;
      margin-right: auto;
      padding-left: var(--container-pad);
      padding-right: var(--container-pad);
    }

    a:focus-visible, button:focus-visible {
      outline: 2px solid var(--accent-gold);
      outline-offset: 3px;
    }

    /* Buttons & Badges */
    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.6rem;
      font-family: var(--font-heading);
      font-weight: 600;
      font-size: 0.9375rem;
      padding: 0.85rem 1.75rem;
      border-radius: var(--radius-sm);
      transition: var(--transition);
      letter-spacing: 0.02em;
      white-space: nowrap;
    }

    .btn-gold {
      background-color: var(--accent-gold);
      color: var(--bg-midnight);
    }
    .btn-gold:hover {
      background-color: var(--accent-gold-hover);
      transform: translateY(-2px);
      box-shadow: 0 6px 16px rgba(196, 161, 106, 0.25);
    }

    .btn-outline-light {
      border: 1px solid rgba(255, 255, 255, 0.3);
      color: #FFFFFF;
      background-color: transparent;
    }
    .btn-outline-light:hover {
      border-color: #FFFFFF;
      background-color: rgba(255, 255, 255, 0.08);
      transform: translateY(-2px);
    }

    .badge {
      display: inline-flex;
      align-items: center;
      padding: 0.35rem 0.75rem;
      font-family: var(--font-heading);
      font-size: 0.75rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      border-radius: var(--radius-sm);
    }
    .badge-projected {
      background: #FFF4E5;
      color: #B45309;
      border: 1px solid #FCD34D;
    }
    .badge-green {
      background: var(--accent-green-soft);
      color: var(--accent-green);
      border: 1px solid rgba(43, 110, 79, 0.25);
    }
    .badge-navy {
      background: rgba(16, 29, 44, 0.06);
      color: var(--bg-midnight);
      border: 1px solid rgba(16, 29, 44, 0.15);
    }

    .section-eyebrow {
      font-family: var(--font-heading);
      font-size: 0.8125rem;
      text-transform: uppercase;
      letter-spacing: 0.12em;
      font-weight: 700;
      color: var(--accent-gold);
      display: block;
      margin-bottom: 0.65rem;
    }
    .section-title {
      font-size: clamp(2rem, 3.5vw, 2.75rem);
      margin-bottom: 1rem;
    }
    .section-description {
      font-size: 1.125rem;
      color: var(--text-muted);
      max-width: 680px;
      line-height: 1.6;
    }

    /* Sticky Header */
    .site-header {
      position: sticky;
      top: 0;
      left: 0;
      width: 100%;
      background-color: rgba(16, 29, 44, 0.96);
      backdrop-filter: blur(10px);
      -webkit-backdrop-filter: blur(10px);
      z-index: 1000;
      border-bottom: 1px solid var(--border-dark);
    }
    .header-inner {
      display: flex;
      align-items: center;
      justify-content: space-between;
      height: 76px;
    }
    .brand-link {
      display: flex;
      align-items: center;
      gap: 0.875rem;
    }
    .brand-monogram {
      width: 42px;
      height: 42px;
      border-radius: var(--radius-sm);
      background: linear-gradient(135deg, var(--accent-gold), #8A6D3F);
      color: #101D2C;
      font-family: var(--font-heading);
      font-weight: 800;
      font-size: 1.15rem;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .brand-info {
      display: flex;
      flex-direction: column;
    }
    .brand-name {
      font-family: var(--font-heading);
      font-weight: 700;
      font-size: 1.05rem;
      color: #FFFFFF;
      line-height: 1.2;
    }
    .brand-title {
      font-size: 0.75rem;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      color: var(--accent-gold);
    }
    .nav-menu {
      display: flex;
      align-items: center;
      list-style: none;
      gap: 1.75rem;
    }
    .nav-menu a {
      font-family: var(--font-heading);
      font-size: 0.875rem;
      font-weight: 500;
      color: var(--text-light-muted);
    }
    .nav-menu a:hover {
      color: #FFFFFF;
    }
    .header-actions {
      display: flex;
      align-items: center;
      gap: 1rem;
    }
    .menu-toggle {
      display: none;
      color: #FFFFFF;
      padding: 0.5rem;
    }

    @media (max-width: 960px) {
      .menu-toggle { display: block; }
      .nav-menu {
        position: absolute;
        top: 76px;
        left: 0;
        width: 100%;
        background-color: var(--bg-midnight);
        border-bottom: 1px solid var(--border-dark);
        flex-direction: column;
        align-items: flex-start;
        padding: 1.5rem var(--container-pad);
        gap: 1.25rem;
        display: none;
      }
      .nav-menu.is-open { display: flex; }
      .header-actions .btn { display: none; }
    }

    /* Hero */
    .hero-section {
      background-color: var(--bg-midnight);
      color: #FFFFFF;
      padding-top: clamp(3rem, 6vw, 5.5rem);
      padding-bottom: clamp(3.5rem, 6vw, 5.5rem);
      border-bottom: 1px solid var(--border-dark);
    }
    .hero-grid {
      display: grid;
      grid-template-columns: 1.15fr 0.85fr;
      gap: clamp(2rem, 5vw, 4.5rem);
      align-items: center;
    }
    .hero-tags {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
      margin-bottom: 1.5rem;
    }
    .hero-tag {
      background: rgba(255, 255, 255, 0.06);
      border: 1px solid rgba(255, 255, 255, 0.14);
      color: var(--accent-gold);
      font-family: var(--font-heading);
      font-size: 0.785rem;
      font-weight: 600;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      padding: 0.35rem 0.85rem;
      border-radius: var(--radius-sm);
    }
    .hero-headline {
      color: #FFFFFF;
      font-size: clamp(2.35rem, 4.2vw, 3.4rem);
      font-weight: 800;
      line-height: 1.12;
      margin-bottom: 1.35rem;
      letter-spacing: -0.025em;
    }
    .hero-headline span {
      color: var(--accent-gold);
    }
    .hero-subheading {
      font-size: clamp(1.05rem, 1.4vw, 1.22rem);
      color: var(--text-light-muted);
      line-height: 1.6;
      margin-bottom: 2.25rem;
      max-width: 600px;
    }
    .hero-ctas {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 1rem;
    }
    .hero-portrait-card {
      position: relative;
      background: var(--bg-navy-elevated);
      border: 1px solid var(--border-dark);
      border-radius: var(--radius-md);
      overflow: hidden;
      box-shadow: 0 20px 40px rgba(0, 0, 0, 0.4);
    }
    .hero-portrait-card img {
      width: 100%;
      height: 480px;
      object-fit: cover;
      object-position: center top;
      display: block;
    }
    .portrait-fallback {
      width: 100%;
      height: 480px;
      background: linear-gradient(145deg, #1A2A3D, #0D1622);
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      color: var(--text-light-muted);
      padding: 2rem;
      text-align: center;
    }
    .portrait-fallback svg {
      width: 80px;
      height: 80px;
      stroke: var(--accent-gold);
      margin-bottom: 1rem;
      opacity: 0.8;
    }
    .hero-portrait-caption {
      padding: 1rem 1.25rem;
      background: rgba(16, 29, 44, 0.9);
      border-top: 1px solid var(--border-dark);
      display: flex;
      align-items: center;
      justify-content: space-between;
    }
    .caption-meta h2 {
      font-size: 1rem;
      color: #FFFFFF;
      font-weight: 700;
    }
    .caption-meta p {
      font-size: 0.785rem;
      color: var(--accent-gold);
    }

    @media (max-width: 960px) {
      .hero-grid { grid-template-columns: 1fr; }
      .hero-portrait-card img, .portrait-fallback { height: 380px; }
    }

    /* Metrics Row */
    .metrics-section {
      background-color: var(--bg-navy-elevated);
      border-bottom: 1px solid var(--border-dark);
      color: #FFFFFF;
      padding: 2.5rem 0;
    }
    .metrics-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 1.5rem;
    }
    .metric-card {
      padding: 0.75rem 1rem;
      border-left: 2px solid var(--accent-gold);
    }
    .metric-number {
      font-family: var(--font-heading);
      font-size: clamp(1.85rem, 2.8vw, 2.45rem);
      font-weight: 800;
      color: #FFFFFF;
      line-height: 1.1;
      margin-bottom: 0.35rem;
    }
    .metric-number span { color: var(--accent-gold); }
    .metric-label {
      font-size: 0.85rem;
      color: var(--text-light-muted);
      line-height: 1.35;
    }

    @media (max-width: 768px) {
      .metrics-grid { grid-template-columns: repeat(2, 1fr); gap: 1.75rem 1.25rem; }
    }
    @media (max-width: 480px) {
      .metrics-grid { grid-template-columns: 1fr; }
    }

    /* About Section */
    .about-section {
      padding: var(--section-pad-y) 0;
      background-color: var(--bg-paper);
    }
    .about-grid {
      display: grid;
      grid-template-columns: 1.1fr 0.9fr;
      gap: clamp(2rem, 5vw, 4rem);
      align-items: start;
    }
    .about-lead {
      font-size: 1.2rem;
      color: var(--text-dark);
      font-weight: 500;
      line-height: 1.6;
      margin-bottom: 1.35rem;
    }
    .about-text {
      color: var(--text-muted);
      font-size: 1rem;
      line-height: 1.75;
    }
    .about-context-panel {
      background-color: #FFFFFF;
      border: 1px solid var(--border-light);
      border-radius: var(--radius-md);
      padding: 2rem;
      box-shadow: 0 4px 20px rgba(0, 0, 0, 0.03);
    }
    .panel-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      border-bottom: 1px solid var(--border-light);
      padding-bottom: 1.25rem;
      margin-bottom: 1.5rem;
    }
    .panel-title {
      font-size: 1.05rem;
      font-weight: 700;
    }
    .corp-ref-mark {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      font-size: 0.75rem;
      color: var(--text-muted);
      background: var(--bg-paper-alt);
      padding: 0.25rem 0.65rem;
      border-radius: var(--radius-sm);
    }
    .corp-ref-mark img { max-height: 20px; width: auto; }
    .spec-list {
      list-style: none;
      display: flex;
      flex-direction: column;
      gap: 1.15rem;
    }
    .spec-item { display: flex; gap: 1rem; }
    .spec-icon {
      flex-shrink: 0;
      width: 36px;
      height: 36px;
      border-radius: var(--radius-sm);
      background: var(--accent-gold-soft);
      color: #936B28;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .spec-icon svg { width: 18px; height: 18px; stroke: currentColor; }
    .spec-content h4 { font-size: 0.9375rem; margin-bottom: 0.2rem; }
    .spec-content p { font-size: 0.85rem; color: var(--text-muted); margin-bottom: 0; }

    @media (max-width: 900px) {
      .about-grid { grid-template-columns: 1fr; }
    }

    /* Capabilities */
    .capabilities-section {
      padding: var(--section-pad-y) 0;
      background-color: var(--bg-paper-alt);
      border-top: 1px solid var(--border-light);
      border-bottom: 1px solid var(--border-light);
    }
    .capabilities-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 1.5rem;
      margin-top: 2.5rem;
    }
    .cap-card {
      background: #FFFFFF;
      padding: 2rem 1.75rem;
      border-radius: var(--radius-md);
      border: 1px solid var(--border-light);
      transition: var(--transition);
      display: flex;
      flex-direction: column;
    }
    .cap-card:hover {
      transform: translateY(-4px);
      box-shadow: 0 12px 24px rgba(16, 29, 44, 0.08);
      border-color: rgba(196, 161, 106, 0.5);
    }
    .cap-card-number {
      font-family: var(--font-heading);
      font-size: 0.8125rem;
      font-weight: 700;
      color: var(--accent-gold);
      margin-bottom: 0.85rem;
    }
    .cap-card h3 { font-size: 1.15rem; margin-bottom: 0.75rem; }
    .cap-card p { font-size: 0.9rem; color: var(--text-muted); line-height: 1.6; }

    @media (max-width: 960px) { .capabilities-grid { grid-template-columns: repeat(2, 1fr); } }
    @media (max-width: 640px) { .capabilities-grid { grid-template-columns: 1fr; } }

    /* Timeline */
    .career-section {
      padding: var(--section-pad-y) 0;
      background-color: var(--bg-paper);
    }
    .career-timeline {
      margin-top: 3rem;
      position: relative;
      padding-left: 2rem;
      border-left: 2px solid var(--border-light);
    }
    .timeline-item {
      position: relative;
      margin-bottom: 2.5rem;
    }
    .timeline-item:last-child { margin-bottom: 0; }
    .timeline-bullet {
      position: absolute;
      left: calc(-2rem - 6px);
      top: 4px;
      width: 10px;
      height: 10px;
      border-radius: 50%;
      background-color: var(--text-dark);
      border: 3px solid var(--bg-paper);
    }
    .timeline-item.current .timeline-bullet {
      background-color: var(--accent-gold);
      box-shadow: 0 0 0 4px var(--accent-gold-soft);
    }
    .timeline-header {
      display: flex;
      flex-wrap: wrap;
      align-items: baseline;
      gap: 0.75rem;
      margin-bottom: 0.35rem;
    }
    .timeline-org {
      font-family: var(--font-heading);
      font-weight: 700;
      font-size: 1.125rem;
    }
    .timeline-date {
      font-size: 0.8125rem;
      font-weight: 700;
      color: #936B28;
      background: var(--accent-gold-soft);
      padding: 0.15rem 0.55rem;
      border-radius: var(--radius-sm);
    }
    .timeline-role {
      font-size: 0.95rem;
      font-weight: 600;
      color: var(--text-muted);
      margin-bottom: 0.35rem;
    }
    .timeline-note {
      font-size: 0.875rem;
      color: var(--text-muted);
      max-width: 780px;
    }

    /* Work & Case Studies */
    .work-section {
      padding: var(--section-pad-y) 0;
      background-color: var(--bg-paper-alt);
      border-top: 1px solid var(--border-light);
    }
    .case-card {
      background: #FFFFFF;
      border-radius: var(--radius-lg);
      border: 1px solid var(--border-light);
      overflow: hidden;
      margin-bottom: 3rem;
      box-shadow: 0 6px 20px rgba(0, 0, 0, 0.04);
    }
    .case-card:last-child { margin-bottom: 0; }
    .case-card-header {
      padding: clamp(1.75rem, 3vw, 2.5rem);
      border-bottom: 1px solid var(--border-light);
    }
    .case-meta {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 0.75rem;
      margin-bottom: 0.75rem;
    }
    .case-title {
      font-size: clamp(1.4rem, 2.2vw, 1.85rem);
      margin-bottom: 0.5rem;
    }
    .case-subtitle {
      font-size: 1rem;
      color: var(--text-muted);
      max-width: 800px;
    }
    .case-body {
      padding: clamp(1.75rem, 3vw, 2.5rem);
    }
    .transformation-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 1.5rem;
      margin-bottom: 2rem;
    }
    .trans-box {
      background: var(--bg-paper);
      padding: 1.5rem;
      border-radius: var(--radius-sm);
      border-left: 3px solid var(--accent-gold);
    }
    .trans-box h4 { font-size: 1rem; margin-bottom: 0.5rem; }
    .trans-box p { font-size: 0.875rem; color: var(--text-muted); line-height: 1.55; }

    .projection-callout {
      background: #FFFBEB;
      border: 1px solid #FDE68A;
      border-radius: var(--radius-sm);
      padding: 1.25rem 1.5rem;
      margin-bottom: 2rem;
      display: flex;
      gap: 1rem;
      align-items: flex-start;
    }
    .projection-callout svg {
      width: 22px;
      height: 22px;
      stroke: #B45309;
      flex-shrink: 0;
      margin-top: 2px;
    }
    .projection-callout-text h4 {
      font-size: 0.9375rem;
      color: #92400E;
      margin-bottom: 0.25rem;
    }
    .projection-callout-text p {
      font-size: 0.85rem;
      color: #78350F;
      margin-bottom: 0;
    }
    .growth-metrics-row {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 1.25rem;
      margin-bottom: 2rem;
    }
    .growth-stat-card {
      background: var(--bg-paper);
      padding: 1.25rem;
      border-radius: var(--radius-sm);
      border: 1px solid var(--border-light);
    }
    .growth-stat-badge {
      font-size: 0.7rem;
      text-transform: uppercase;
      font-weight: 700;
      color: #B45309;
      margin-bottom: 0.25rem;
      display: block;
    }
    .growth-stat-val {
      font-family: var(--font-heading);
      font-size: 1.5rem;
      font-weight: 800;
      color: var(--text-dark);
      line-height: 1.2;
    }
    .growth-stat-desc {
      font-size: 0.785rem;
      color: var(--text-muted);
      margin-top: 0.35rem;
    }
    .table-container {
      overflow-x: auto;
      margin-bottom: 2rem;
      border: 1px solid var(--border-light);
      border-radius: var(--radius-sm);
    }
    .phase-table {
      width: 100%;
      border-collapse: collapse;
      text-align: left;
      font-size: 0.875rem;
    }
    .phase-table th, .phase-table td {
      padding: 1rem 1.25rem;
      border-bottom: 1px solid var(--border-light);
    }
    .phase-table th {
